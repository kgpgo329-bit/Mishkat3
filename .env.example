# ==============================================================================
# Mishkat Islamic Knowledge Platform - Environment Configuration Example
# ALL API KEYS AND SECRETS ARE STRICTLY SERVER-SIDE. NEVER EXPOSE TO FRONTEND.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Gemini AI Provider Configuration (Server-side ONLY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_REQUEST_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2

# Firebase Firestore Configuration (Server-side ONLY)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Platform Policy Configuration
ASSESSMENT_ELIGIBILITY_THRESHOLD=20
SESSION_COOKIE_SECRET=change-this-in-production-to-a-secure-random-key

# Logging & Telemetry
LOG_LEVEL=info
